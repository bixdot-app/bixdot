{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BixDot",
  "version": "0.1.0",
  "identifier": "app.bixdot.bixdot",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:8747",
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BixDot",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "url": "http://localhost:8747"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../frontend/**/*"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first AI agent. No cloud required.",
    "longDescription": "BixDot is a secure, local-first AI agent that runs entirely on your device. Zero-trust architecture, mandatory auth, tamper-evident audit log.",
    "copyright": "© 2026 DigiTech Business Pte. Ltd.",
    "publisher": "DigiTech Business Pte. Ltd.",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
